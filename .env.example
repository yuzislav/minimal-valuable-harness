DEBUG=false
LLM_PROVIDER=gemini
#LLM_PROVIDER=local
#LLM_PROVIDER=openai
MAX_ITERATIONS=15

GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_RPM_LIMIT=15
GEMINI_CONTEXT_LENGTH=2000000

LOCAL_API_URL=http://localhost:11434/v1/chat/completions
LOCAL_MODEL_NAME=gemma3:4b
LOCAL_API_KEY=your_optional_local_api_key
LOCAL_CONTEXT_LENGTH=128000

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CONTEXT_LENGTH=128000

# Context Management Strategy (cut_middle, drop_oldest)
CONTEXT_STRATEGY=cut_middle
# Telegram Bot UI configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USERS=your_username,another_user
