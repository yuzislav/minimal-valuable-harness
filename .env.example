DEBUG=false
LLM_PROVIDER=gemini
#LLM_PROVIDER=local
#LLM_PROVIDER=openai
MAX_ITERATIONS=15
# Tool-call format the model uses: xml (default) or json
TOOL_FORMAT=xml

GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
# Requests per minute; throttles Gemini calls only (0 or unset = no throttle)
GEMINI_RPM_LIMIT=15
GEMINI_CONTEXT_LENGTH=2000000

LOCAL_API_URL=http://localhost:11434/v1/chat/completions
LOCAL_MODEL_NAME=gemma3:4b
LOCAL_API_KEY=your_optional_local_api_key
LOCAL_CONTEXT_LENGTH=128000

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CONTEXT_LENGTH=128000

# Context Management Strategy (cut_middle, drop_oldest)
CONTEXT_STRATEGY=cut_middle

# Allow the `curl` tool to reach loopback/link-local/private-range addresses.
# Leave unset (default) to block them; only set to "true" if you trust every
# URL the model can be made to fetch (including via prompt injection).
#CURL_ALLOW_PRIVATE=true

# Telegram Bot UI configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated numeric Telegram user IDs (not usernames - see README). The
# bot refuses to start if this is unset, unless TELEGRAM_ALLOW_ALL=true.
TELEGRAM_ALLOWED_USERS=123456789,987654321
# Set to "true" to explicitly allow every user with no allow-list. Dangerous:
# this exposes the exec/curl tools to anyone who finds the bot.
#TELEGRAM_ALLOW_ALL=true
