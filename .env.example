DEBUG=false
LLM_PROVIDER=gemini
#LLM_PROVIDER=local

GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_RPM_LIMIT=15
GEMINI_CONTEXT_LENGTH=2000000

LOCAL_API_URL=http://localhost:11434/v1/chat/completions
LOCAL_MODEL_NAME=gemma3:4b
LOCAL_API_KEY=your_optional_local_api_key
LOCAL_CONTEXT_LENGTH=128000

# Telegram Bot UI configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USERS=your_username,another_user
